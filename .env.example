# Copy this file to .env for local development.
# Never commit .env or real secrets.

# PostgreSQL / Docker Compose
POSTGRES_DB=blocktrace
POSTGRES_USER=blocktrace
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5432
DATABASE_URL=postgresql://blocktrace:change_me_in_local_env@localhost:5432/blocktrace?schema=public

# Backend
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Session configuration. Backend only. Do not prefix with NEXT_PUBLIC_.
SESSION_SECRET=replace_with_a_long_random_string
SESSION_DURATION_HOURS=8

# Optional override for the local seed password. Backend/seed only.
SEED_DEV_PASSWORD=BlockTraceDev!2026

# Private evidence storage. Backend only. Do not prefix with NEXT_PUBLIC_.
STORAGE_PATH=./storage/evidence
MAX_UPLOAD_SIZE_MB=10

# Local Hardhat only. Backend only. Do not prefix with NEXT_PUBLIC_.
# These are the well-known Hardhat development keys. Never use them outside localhost.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKTRACE_CONTRACT_ADDRESS=
BLOCKTRACE_INVESTIGATOR1_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
BLOCKTRACE_INVESTIGATOR2_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# Frontend public configuration only
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
